local function findPart(path)
	local current = Workspace
	for name in string.gmatch(path, "[^.]+") do
		current = current:FindFirstChild(name)
		if current == nil then
			return nil
		end
	end
	return current
end

-- apply(): place every static world part at its target CFrame.
-- Runs once at server start, before any gameplay reads positions.
local function apply()
	local placed = 0
	local missing = 0
	for _, entry in ipairs(LAYOUT) do
		local path, target = entry[1], entry[2]
		local part = findPart(path)
		if part ~= nil and part:IsA("BasePart") then
			part.CFrame = target
			placed += 1
		else
			missing += 1
			warn("[Brainrot Bazaar] WorldLayout: part not found: " .. path)
		end
	end
	print("[Brainrot Bazaar] WorldLayout: placed " .. tostring(placed) .. " parts, " .. tostring(missing) .. " missing.")
end

return {
	apply = apply,
}
